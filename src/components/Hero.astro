---
<section class="hero" id="home">
  <div class="pcb-bg"></div>
  <svg
    class="traces"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!--Top left -->
    <polyline points="0,128 222,128 258,168" class="trace"/>
    <circle cx="258" cy="168" r="5" class="pad"/>
    <polyline points="0,168 62,168 98,208" class="trace" />
    <polyline points="510,0 510,68" class="trace"/> <!--Top nav connection -->

    <!--Top right -->
    <polyline points="725,0 725,52 762,90 902,90" class="trace"/>
    <circle cx="902" cy="90" r="5" class="pad"/>
    <polyline points="818,0 818,90 878,150 1300,150" class="trace"/>

    <!--Right -->
    <polyline points="1440,310 862,310 822,350 822,445" class="trace" />

    <!--Bottom -->
    <polyline points="292,900 292,768 338,722 492,722" class="trace" />
    <polyline points="502,900 502,808 548,762 642,762" class="trace"/>
    <circle cx="642" cy="762" r="5" class="pad"/>
  </svg>

  <div class="hero-content">
    <p class="hello">Hello there!</p>
    <p class="iam">I am...</p>
    <h1 class="name">Swastik Bajpai</h1>
    <p class="bio">
      A 15 year old from Kanpur, India who is always curious about hardware and is also a front end developer.
      I build firmwares, AI that can see and PCBs, all from scratch!
    </p>
  </div>
</section>

<style>
  .pcb-bg {
    position: absolute;
    inset: 0;
    background-image: url('../assets/pcb.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: var(--space-24) var(--space-8);
  }

  .traces {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .trace {
    fill: none;
    stroke: #0ea5c9;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .pad {
    fill: #0ea5c9;
    opacity: 0.9;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .hero, .iam {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--text);
    margin-bottom: var(--space-6);
    line-height: 1.05;
  }

  .bio {
    font-size: var(--text-base);
    color: var(--text-muted);
    max-width: 52ch;
    line-height: 1.7;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-dot {
    width: 6px;
    height: 8px;
    border-radius: 50%;
    background: var(--trace);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(8px); }
  }
</style>