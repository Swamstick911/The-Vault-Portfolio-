<script>
import { gsap } from 'gsap';

const svg = document.querySelector('.traces') as SVGSVGElement;
const traces = document.querySelectorAll('.trace') as NodeListOf<SVGPolylineElement>;

function parsePoints(trace: SVGPolylineElement) {
  return trace.getAttribute('points')!
    .trim()
    .split(/\s+/)
    .map(p => {
      const [x, y] = p.split(',').map(Number);
      return { x, y };
    });
}

function segmentLengths(pts: {x:number,y:number}[]) {
  return pts.slice(1).map((p, i) => {
    const dx = p.x - pts[i].x;
    const dy = p.y - pts[i].y;
    return Math.sqrt(dx * dx + dy * dy);
  });
}

function totalLength(lens: number[]) {
  return lens.reduce((a, b) => a + b, 0);
}

//Get exact pos at a given distance along the polyline
function posAtDist(pts: {x:number,y:number}[], lens: number[], dist: number) {
  let remaining = dist;
  for (let i = 0; i < lens.length; i++) {
    if (remaining <= lens[i]) {
      const t = remaining / lens[i];
      return {
        x: pts[i].x + t * (pts[i+1].x - pts[i].x),
        y: pts[i].y + t * (pts[i+1].y - pts[i].y)
      };
    }
    remaining -= lens[i];
  }
  return pts[pts.length - 1];
}

function createDot() {
  const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  line.setAttribute('stroke', '#a8eeff');
  line.setAttribute('stroke-width', '1.5');
  line.setAttribute('stroke-linecap', 'round');
  line.style.filter = 'drop-shadow(0 0 4px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.8))';
  line.style.opacity = '0';
  svg.appendChild(line);
  return line as unknown as SVGCircleElement;
}

function animateDot(dot: SVGCircleElement, pts: {x:number,y:number}[], lens: number[], total: number, duration: number) {
  //Use a proxy object to drive the distance value
  const proxy = { dist: 0 };

  gsap.set(dot, { opacity: 0 });

  gsap.timeline({
    onComplete: () => {
      //Random pause before next pulse [2-6sec]
      const pause = 2 + Math.random() * 4;
      setTimeout(() => animateDot(dot, pts, lens, total, duration), pause * 1000);
    }
  })
  .to(dot, { opacity: 1, duration: 0.2, ease: 'none' })
  .to(proxy, {
    dist: total,
    duration,
    ease: 'power1.inOut',
    onUpdate: () => {
      const TAIL = 18; // length of the glowing segment in px
      const pos = posAtDist(pts, lens, proxy.dist);
      const tailDist = Math.max(0, proxy.dist - TAIL);
      const tail = posAtDist(pts, lens, tailDist);

      (dot as unknown as SVGLineElement).setAttribute('x1', String(tail.x));
      (dot as unknown as SVGLineElement).setAttribute('y1', String(tail.y));
      (dot as unknown as SVGLineElement).setAttribute('x2', String(pos.x));
      (dot as unknown as SVGLineElement).setAttribute('y2', String(pos.y));
    }
  })
  .to(dot, { opacity: 0, duration: 0.2, ease: 'none' }, `-=0.2`);
}

traces.forEach((trace, i) => {
  const pts = parsePoints(trace);
  const lens = segmentLengths(pts);
  const total = totalLength(lens);

  //Variable speed - shorter traces = faster, and longer traces = slower
  //Range- 1.5s-4s
  const duration = 1.5 + (total / 800) * 2.5;

  const dot = createDot();

  //Stagger initial start- each trace waits i*0.8s + small random offset
  const initialDelay = i * 0.8 + Math.random() * 1.5;
  setTimeout(() => animateDot(dot, pts, lens, total, duration), initialDelay * 1000);
});
</script>
