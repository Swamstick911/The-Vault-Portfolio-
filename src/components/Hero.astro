---
---
<section class="hero" id="home">

    <!--PCB Traces SVG -->
    <svg class="traces" viewBox="0 0 900 700" xmlns="http://www.w3.org/2000/svg">
        <!--Top left traces -->
        <polyline points="0,120 80,120 120,160 220,160" class="trace-line" />
        <polyline points="0,140 60,140 100,180 180,180" class="trace-line" />
        <circle cx="220" cy="160" r="5" class="trace-pad" />

        <!--Top right traces -->
        <polyline points="900,80 820,80 780,120 680,120" class="trace-line" />
        <polyline points="900,60 840,60 800,100 720,100 720,200" class="trace-line" />
        <circle cx="680" cy="120" r="5" class="trace-pad" />
        <circle cx="720" cy="200" r="5" class="trace-pad" />

        <!--Right side traces -->
        <polyline points="900,350 820,350 780,310" class="trace-line" />
        <polyline points="900,400 800,400 800,480 760,480" class="trace-line" />
        <circle cx="760" cy="480" r="5" class="trace-pad" />
    </svg>

    <!--Hero content -->
    <div class="hero-content">
        <p class="hello">Hello there!</p>
        <p class="iam">I am...</p>
        <h1 class="name">Swastik Bajpai</h1>
        <p class="bio">
            A 15-year old from Kanpur, India who is always curious about hardware and also a front end developer.
            I build firmwares, AI that can see and PCBs all from scratch!
        </p>
    </div>

    <!--Scroll indicator -->
    <div class="scroll-indicator">
        <svg width="2" height="60" viewBox="0 0 2 60">
            <line x1="1" y1="0" x2="1" y2="60" stroke="var(--trace)" stroke-width="1" opacity="0.3"/>
        </svg>
        <div class="scroll-dot"></div>
    </div>

</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding: var(--space-24) var(--space-8);
    }

    .traces {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .trace-line {
        fill: none;
        stroke: var(--trace);
        stroke-width: 1.5;
        opacity: 0.7;
    }

    .trace-pad {
        fill: var(--trace);
        opacity: 0.9;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
    }

    .hello {
        font-size: var(--text-lg);
        color: var(--text-muted);
        margin-bottom: var(--space-1);
    }

    .iam {
        font-size: var(--text-lg);
        color: var(--text-muted);
        margin-bottom: var(--space-2);
    }

    .name {
        font-family: var(--font-display);
        font-size: var(--text-hero);
        color: var(--text);
        margin-bottom: var(--space-6);
        line-height: 1.05;
    }

    .bio {
        font-size: var(--text-base);
        color: var(--text-muted);
        max-width: 55ch;
        line-height: 1.7;
    }

    .scroll-indicator {
        position: absolute;
        bottom: var(--space-8);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
    }

    .scroll-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--trace);
        animation: scrollPulse 2s ease-in-out infinite;
    }

    @keyframes scrollPulse {
        0%, 100% { opacity: 0.3; transform: translateY(0);}
        50% { opacity: 1; transform: translateY(8px); }
    }
</style>