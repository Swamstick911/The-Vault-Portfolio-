---
---
<section class="hero" id="home">
  <canvas class="traces-canvas" id="tracesCanvas"></canvas>

  <div class="hero-content">
    <p class="hello">Hello there!</p>
    <p class="iam">I am...</p>
    <h1 class="name">Swastik Bajpai</h1>
    <p class="bio">
      A 15-year old from Kanpur, India who is always curious about hardware
      and is also a front end developer. I build firmwares, AI that can see and
      PCBs, all from scratch!
    </p>
  </div>

  <div class="scroll-indicator">
    <svg width="2" height="60" viewBox="0 0 2 60">
      <line x1="1" y1="0" x2="1" y2="60" stroke="var(--trace)" stroke-width="1" opacity="0.3"/>
    </svg>
    <div class="scroll-dot"></div>
  </div>
</section>

<script>
const canvas = document.getElementById('tracesCanvas') as HTMLCanvasElement;
const ctx = canvas.getContext('2d')!;
const MIN_DIST = 130;
const MAX_NEIGHBORS = 1;
const MARGIN = 80;
const MAX_TRACES = 11;
const EDGE_OFFSET = 15;

function rand(min: number, max: number) {
  return Math.random() * (max - min) + min;
}

function dist(x1: number, y1: number, x2: number, y2: number) {
  return Math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);
}

interface TracePoint { x: number; y: number}
interface Trace {
  points: TracePoint[];
  hasPad: boolean;
}

function buildTrace(sx: number, sy: number, edge: string): Trace {
  const diagLen = rand(60, 110);      // longer diagonal
  const straightLen = rand(120, 220); // much longer straight run
  const goRight = Math.random() > 0.5;
  const hasPad = Math.random() > 0.45;

  let start: TracePoint, mid: TracePoint, end: TracePoint;

  switch (edge) {
    case 'top':
      start = { x: sx, y: EDGE_OFFSET };
      mid   = { x: sx + (goRight ? diagLen : -diagLen), y: EDGE_OFFSET + diagLen };
      end   = { x: mid.x, y: mid.y + straightLen };
      break;
    case 'bottom':
      start = { x: sx, y: canvas.height - EDGE_OFFSET };
      mid   = { x: sx + (goRight ? diagLen : -diagLen), y: canvas.height - EDGE_OFFSET - diagLen };
      end   = { x: mid.x, y: mid.y - straightLen };
      break;
    case 'right':
      start = { x: canvas.width - EDGE_OFFSET, y: sy };
      mid   = { x: canvas.width - EDGE_OFFSET - diagLen, y: sy + (goRight ? diagLen : -diagLen) };
      end   = { x: mid.x - straightLen, y: mid.y };
      break;
    default: // left
      start = { x: EDGE_OFFSET, y: sy };
      mid   = { x: EDGE_OFFSET + diagLen, y: sy + (goRight ? diagLen : -diagLen) };
      end   = { x: mid.x + straightLen, y: mid.y };
      break;
  }

  return { points: [start, mid, end], hasPad };
}

function drawTraces() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const w = canvas.width;
  const h = canvas.height;
  const MIN_DIST = 130; //min distance between two start points
  const MAX_NEIGHBORS = 1; //max 1 other trace within 2x MAX_DIST 
  const MARGIN = 100; //stay away from corners
  const MAX_TRACES = 11;

  //Protected content zone
  const contentZone = {
    x1: 0, y1: h * 0.15,
    x2: w * 0.65, y2: h * 0.75
  };

  function inContentZone(x: number, y: number) {
    return x > contentZone.x1 && x < contentZone.x2 && y > contentZone.y1 && y < contentZone.y2; 
  }

  //Generate candidates spread across all 4 edges
  type Candidate = {x: number, y: number, edge: string};
  const candidates: Candidate[] = [];

  const steps = 25;
  for (let i = 0; i < steps; i++) {
    const t = i/steps;
    candidates.push({x: MARGIN + t * (w - MARGIN * 2), y: 0, edge: 'top'});
    candidates.push({x: MARGIN + t * (w - MARGIN * 2), y: h, edge: 'bottom'});
    candidates.push({x: w, y: MARGIN + t * (h - MARGIN * 2), edge: 'right'});
    candidates.push({x: 0, y: MARGIN + t * (h - MARGIN * 2), edge: 'left'});
  }

  //Shuffle
  candidates.sort(() => Math.random() - 0.5);

  const placed: Candidate[] = [];

  for (const c of candidates) {
    if (placed.length >= MAX_TRACES) break;

    //Check min distance
    const tooClose = placed.some(p => dist(p.x, p.y, c.x, c.y) < MIN_DIST);
    if (tooClose) continue;

    //Max 1 neighbor within 2x MIN_DIST
    const nearbyCount = placed.filter(p => dist(p.x, p.y, c.x, c.y) < MIN_DIST * 2).length;
    if (nearbyCount > MAX_NEIGHBORS) continue;

    placed.push(c);
  }

  //Build and draw traces
  placed.forEach(p => {
    const trace = buildTrace(p.x, p.y, p.edge);

    //Skip if endpoint lands in content zone
    const end = trace.points[2];
    if (inContentZone(end.x, end.y)) return;

    ctx.beginPath();
    ctx.moveTo(trace.points[0].x, trace.points[0].y);
    trace.points.slice(1).forEach(pt => ctx.lineTo(pt.x, pt.y));
    ctx.strokeStyle = '#0ea5c9';
    ctx.lineWidth = 1.5;
    ctx.globalAlpha = 0.65;
    ctx.stroke();

    if (trace.hasPad) {
      const pad = trace.points[2];
      ctx.beginPath();
      ctx.arc(pad.x, pad.y, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = '#0ea5c9';
      ctx.globalAlpha = 0.9;
      ctx.fill();
    }

    ctx.globalAlpha = 1;
  });
}

drawTraces();
window.addEventListener('resize', drawTraces);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: var(--space-24) var(--space-8);
  }

  .traces-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .hello, .iam {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--text);
    margin-bottom: var(--space-6);
    line-height: 1.05;
  }

  .bio {
    font-size: var(--text-base);
    color: var(--text-muted);
    max-width: 55ch;
    line-height: 1.7;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--trace);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(8px); }
  }
</style>