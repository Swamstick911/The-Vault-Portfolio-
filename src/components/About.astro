<section id="about" class="about">

    <svg class="traces" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <!--left -->
        <polyline points="80,550 80,400 120,350" class="trace"/>
        <polyline points="500,250 700,250 800,300" class="trace"/>

        <!-- Top right -->
        <polyline points="1350,350 1200,350 1150,400" class="trace"/>
        <circle cx="1350" cy="350" r="5" class="pad"/>

        <!-- Bottom -->
        <polyline points="500,780 700,780 740,740" class="trace"/>
        <circle cx="740" cy="740" r="5" class="pad" />
        <polyline points="620,750 440,750" class="trace" />
    </svg>
    <!--Top row -->
    <div class="about-top">
        <h2 class="about-heading">About Me</h2>
        <a href="https://github.com/Swamstick911" target="_blank" rel="noopener noreferrer" class="github-link">
            <span>Check out my GitHub!</span>
            <svg class="arrow" width="60" height="30" viewBox="0 0 60 30" fill="none">
                <polyline points="0,20 50,8" stroke="var(--trace)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="44,4 50,8 45,15" stroke="var(--trace)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="var(--trace)" aria-label="GitHub">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
        </a>
    </div>


    <!--Bio -->
    <p class="about-bio">
        I am a 15-year old based in Kanpur, India. I sit at the intersection of AI, Hardware and Web development.
        Currently really obsessed with Keyboard designing and CV (Computer Vision). This is the tech stack:
    </p>


    <!--Cards -->
    <div class="cards-scene">

        <!--Hardware and software cards -->
        <div class="stack-cards">
            <div class="stack-card">
                <h3 class="card-title">Hardware</h3>
                <ul class="stack-list">
                    <li>KiCAD</li>
                    <li>Onshape</li>
                    <li>Circuit Design</li>
                    <li>Micropython</li>
                    <li>Raspberry Pi Pico</li>
                </ul>
            </div>
            <div class="stack-card">
                <h3 class="card-title">Software</h3>
                <ul class="stack-list">
                    <li>Python</li>
                    <li>JavaScript/TypeScript</li>
                    <li>TailwindCSS</li>
                    <li>GSAP</li>
                    <li>Next.js</li>
                </ul>
            </div>
        </div>

    </div>

</section>


<style>
    .about {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: var(--space-20) var(--space-12);
        margin-inline: 0;
        padding: var(--space-24) var(--space-8);
        width: 100%;
        position: relative;
        overflow: hidden;
    }


    .about-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
        margin-bottom: var(--space-6);
    }


    .about-heading {
        font-size: var(--text-hero);
        font-family: var(--font-display);
        color: var(--text);
        line-height: 1;
        margin: 0;
    }


    .github-link {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        color: var(--text-muted);
        font-size: var(--text-sm);
        margin-top: var(--space-4);
        transition: color 180ms ease;
    }


    .github-link:hover {
        color: var(--trace);
    }


    .about-bio {
        font-size: var(--text-base);
        color: var(--text-muted);
        line-height: 1.75;
        margin-bottom: var(--space-12);
        max-width: 72ch;
    }


    .cards-scene {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        justify-content: center;
        width: 100%;
    }


    .stack-cards {
        display: flex;
        gap: var(--space-6);
        flex: 1;
        justify-content: center;
    }


    .stack-card {
        flex: 1;
        max-width: 260px;
        background: rgba(8, 12, 18, 0.6);
        border: 1.5px solid var(--trace);
        border-radius: 24px;
        padding: var(--space-8);
        box-shadow: 0 0 18px rgba(14, 165, 201, 0.1), inset 0 0 24px rgba(14, 165, 201, 0.03);
        transition: box-shadow 200ms ease, transform 200ms ease;
    }


    .stack-card:hover {
        box-shadow: 0 0 32px rgba(14, 165, 201, 0.2), inset 0 0 24px rgba(14, 165, 201, 0.06);
        transform: translateY(-3px);
    }


    .card-title {
        font-size: var(--text-xl);
        font-family: var(--font-display);
        color: var(--text);
        text-align: center;
        margin-bottom: var(--space-6);
        font-weight: 600;
    }


    .stack-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }


    .stack-list li {
        font-size: var(--text-sm);
        color: var(--text-muted);
        padding-left: var(--space-6);
        position: relative;
    }


    .stack-list li::before {
        content: '';
        position: absolute;
        left: var(--space-2);
        top: 50%;
        transform: translateY(-50%);
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--trace);
        box-shadow: 0 0 6px var(--trace);
    }


    .deco-left, .deco-right {
        flex-shrink: 0;
    }


    .deco-bottom {
        display: flex;
        justify-content: center;
        margin-top: var(--space-8);
    }

    .traces {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .trace {
        fill: none;
        stroke: #0ea5c9;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.7;
        filter: drop-shadow(0 0 3px #0ea5c9) drop-shadow(0 0 6px rgba(14,165,201,0.4));
    }

    .pad {
        fill: #0ea5c9;
        opacity: 0.9;
        filter: drop-shadow(0 0 4px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.5))
    }

    .about-top, .about-bio, .cards-scene, .deco-bottom {
        position: relative;
        z-index: 1;
    }


    @media (max-width: 768px) {
        .about-top {
            flex-direction: column;
            gap: var(--space-4);
        }


        .stack-cards {
            flex-direction: column;
            align-items: center;
        }


        .deco-left, .deco-right {
            display: none;
        }
    }
</style>