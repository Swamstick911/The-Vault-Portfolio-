<script>
import { gsap } from 'gsap';

const svg = document.querySelector('.about-traces') as SVGSVGElement;
const traces = svg.querySelectorAll('.trace') as NodeListOf<SVGPolylineElement>;

function parsePoints(trace: SVGPolylineElement) {
  return trace.getAttribute('points')!
    .trim()
    .split(/\s+/)
    .map(p => {
      const [x, y] = p.split(',').map(Number);
      return { x, y };
    });
}

function segmentLengths(pts: {x:number,y:number}[]) {
  return pts.slice(1).map((p, i) => {
    const dx = p.x - pts[i].x;
    const dy = p.y - pts[i].y;
    return Math.sqrt(dx * dx + dy * dy);
  });
}

function totalLength(lens: number[]) {
  return lens.reduce((a, b) => a + b, 0);
}

//Get exact pos at a given distance along the polyline
function posAtDist(pts: {x:number,y:number}[], lens: number[], dist: number) {
  let remaining = dist;
  for (let i = 0; i < lens.length; i++) {
    if (remaining <= lens[i]) {
      const t = remaining / lens[i];
      return {
        x: pts[i].x + t * (pts[i+1].x - pts[i].x),
        y: pts[i].y + t * (pts[i+1].y - pts[i].y)
      };
    }
    remaining -= lens[i];
  }
  return pts[pts.length - 1];
}

function createDot() {
  const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  line.setAttribute('stroke', '#a8eeff');
  line.setAttribute('stroke-width', '1.5');
  line.setAttribute('stroke-linecap', 'round');
  line.style.filter = 'drop-shadow(0 0 4px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.8))';
  line.style.opacity = '0';
  svg.appendChild(line);
  return line as unknown as SVGCircleElement;
}

let timeouts: ReturnType<typeof setTimeout>[] = [];
let running = false;

function animateDot(dot: SVGCircleElement, pts: {x:number,y:number}[], lens: number[], total: number, duration: number) {
  if (!running) return;   // ← exit if stopped

  const proxy = { dist: 0 };

  gsap.set(dot, { opacity: 0 });

  gsap.timeline({
    onComplete: () => {
      if (!running) return;   // ← exit before rescheduling
      //Random pause before next pulse [2-6sec]
      const pause = 2 + Math.random() * 4;
      const id = setTimeout(() => animateDot(dot, pts, lens, total, duration), pause * 1000);
      timeouts.push(id);   // ← track this timeout so stopAll can clear it
    }
  })
  .to(dot, { opacity: 1, duration: 0.2, ease: 'none' })
  .to(proxy, {
    dist: total,
    duration,
    ease: 'power1.inOut',
    onUpdate: () => {
      const TAIL = 18;
      const pos = posAtDist(pts, lens, proxy.dist);
      const tailDist = Math.max(0, proxy.dist - TAIL);
      const tail = posAtDist(pts, lens, tailDist);

      (dot as unknown as SVGLineElement).setAttribute('x1', String(tail.x));
      (dot as unknown as SVGLineElement).setAttribute('y1', String(tail.y));
      (dot as unknown as SVGLineElement).setAttribute('x2', String(pos.x));
      (dot as unknown as SVGLineElement).setAttribute('y2', String(pos.y));
    }
  })
  .to(dot, { opacity: 0, duration: 0.2, ease: 'none' }, `-=0.2`);
}

const traceData = Array.from(traces).map(trace => ({
  pts: parsePoints(trace),
  lens: segmentLengths(parsePoints(trace)),
  dot: createDot(),
  duration: 0
}));

traceData.forEach(td => {
  td.duration = 1.5 + (totalLength(td.lens) / 800) * 2.5;
});

function startAll() {
  if (running) return;
  running = true;
  traceData.forEach((td, i) => {
    const initialDelay = i * 0.8 + Math.random() * 1.5;
    const id = setTimeout(() => animateDot(td.dot, td.pts, td.lens, totalLength(td.lens), td.duration), initialDelay * 1000);
    timeouts.push(id);
  });
}

function stopAll() {
  running = false;
  timeouts.forEach(id => clearTimeout(id));
  timeouts = [];
  gsap.killTweensOf(traceData.map(td => td.dot));
  traceData.forEach(td => gsap.set(td.dot, { opacity: 0 }));
}

const section = document.getElementById('about')!;
const sectionObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      startAll();
    } else {
      stopAll();
    }
  });
}, { threshold: 0.1 });

sectionObserver.observe(section);
</script>

<style>
    .about {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: var(--space-24) var(--space-8);
        width: 100%;
        position: relative;
        overflow: hidden;
    }

    .about-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
        margin-bottom: var(--space-6);
        position: relative;
        z-index: 1;
    }

    .about-heading {
        font-size: var(--text-hero);
        font-family: var(--font-display);
        color: var(--text);
        line-height: 1;
        margin: 0;
    }

    .github-link {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        color: var(--text-muted);
        font-size: var(--text-sm);
        margin-top: var(--space-4);
        transition: color 180ms ease;
    }

    .github-link:hover {
        color: var(--trace);
    }

    .about-bio {
        font-size: var(--text-base);
        color: var(--text-muted);
        line-height: 1.75;
        margin-bottom: var(--space-12);
        max-width: 72ch;
        position: relative;
        z-index: 1;
    }

    .cards-scene {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        justify-content: center;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .stack-cards {
        display: flex;
        gap: var(--space-6);
        justify-content: center;
    }

    .stack-card {
        width: 260px;
        background: rgba(8, 12, 18, 0.6);
        border: 1.5px solid var(--trace);
        border-radius: 24px;
        padding: var(--space-8);
        box-shadow: 0 0 18px rgba(14, 165, 201, 0.1), inset 0 0 24px rgba(14, 165, 201, 0.03);
        transition: box-shadow 200ms ease, transform 200ms ease;
    }

    .stack-card:hover {
        box-shadow: 0 0 32px rgba(14, 165, 201, 0.2), inset 0 0 24px rgba(14, 165, 201, 0.06);
        transform: translateY(-3px);
    }

    .card-title {
        font-size: var(--text-xl);
        font-family: var(--font-display);
        color: var(--text);
        text-align: center;
        margin-bottom: var(--space-6);
        font-weight: 600;
    }

    .stack-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .stack-list li {
        font-size: var(--text-sm);
        color: var(--text-muted);
        padding-left: var(--space-6);
        position: relative;
    }

    .stack-list li::before {
        content: '';
        position: absolute;
        left: var(--space-2);
        top: 50%;
        transform: translateY(-50%);
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--trace);
        box-shadow: 0 0 6px var(--trace);
    }

    .deco-bottom {
        display: flex;
        justify-content: center;
        margin-top: var(--space-8);
    }

    .traces {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .trace {
        fill: none;
        stroke: #0ea5c9;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.7;
        filter: drop-shadow(0 0 3px #0ea5c9) drop-shadow(0 0 6px rgba(14,165,201,0.4));
    }

    .pad {
        fill: #0ea5c9;
        opacity: 0.9;
        filter: drop-shadow(0 0 4px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.5));
    }

    @media (max-width: 768px) {
        .about-top {
            flex-direction: column;
            gap: var(--space-4);
        }

        .stack-cards {
            flex-direction: column;
            align-items: center;
        }
    }
</style>