</section>

<script>
import { gsap } from "gsap";

const keycaps = document.querySelectorAll('.keycap') as NodeListOf<HTMLElement>;

keycaps.forEach(keycap => {
    const top = keycap.querySelector('.keycap-top') as HTMLElement;
    const side = keycap.querySelector('.keycap-side') as HTMLElement;

    keycap.addEventListener('mouseenter', () => {
        gsap.to(top, { y: 6, duration: 0.1, ease: 'power2.out' });
        gsap.to(side, { scaleY: 0.3, transformOrigin: 'top', duration: 0.12, ease: 'power2.out' });
    });

    keycap.addEventListener('mouseleave', () => {
        gsap.to(top, { y: 0, duration: 0.18, ease:'power2.out' });
        gsap.to(side, { scaleY: 1, transformOrigin: 'top', duration: 0.18, ease: 'power2.out'});
    });
});

const svg = document.querySelector('.work-traces') as SVGSVGElement;
const traces = svg.querySelectorAll('.trace') as NodeListOf<SVGPolylineElement>;

function parsePoints(trace: SVGPolylineElement) {
    return trace.getAttribute('points')!.trim().split(/\s+/).map(p => {
        const [x, y] = p.split(',').map(Number);
        return { x, y };
    });
}

function segmentLengths(pts: {x:number, y:number}[]) {
    return pts.slice(1).map((p, i) => {
        const dx = p.x - pts[i].x;
        const dy = p.y - pts[i].y;
        return Math.sqrt(dx * dx + dy * dy);
    });
}

function totalLength(lens: number[]) {
    return lens.reduce((a, b) => a + b, 0);
}

function posAtDist(pts: {x:number, y:number}[], lens: number[], dist: number) {
    let remaining = dist;
    for (let i = 0; i < lens.length; i++) {
        if (remaining <= lens[i]) {
            const t = remaining / lens[i];
            return { x: pts[i].x + t * (pts[i+1].x - pts[i].x), y: pts[i].y + t * (pts[i+1].y - pts[i].y) };
        }
        remaining -= lens[i];
    }
    return pts[pts.length - 1];
}

function createDot() {
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('stroke', '#a8eeff');
    line.setAttribute('stroke-width', '1.5');
    line.setAttribute('stroke-linecap', 'round');
    line.style.filter = 'drop-shadow(0 0 4px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.8))';
    line.style.opacity = '0';
    svg.appendChild(line);
    return line as unknown as SVGCircleElement;
}

let timeouts: ReturnType<typeof setTimeout>[] = [];
let running = false;

function animateDot(dot: SVGCircleElement, pts: {x:number, y:number}[], lens: number[], total: number, duration: number) {
    if (!running) return;
    const proxy = { dist: 0 };
    gsap.set(dot, { opacity: 0 });
    gsap.timeline({
        onComplete: () => {
            if (!running) return;
            const pause = 2 + Math.random() * 4;
            const id = setTimeout(() => animateDot(dot, pts, lens, total, duration), pause * 1000);
            timeouts.push(id);
        }
    })
    .to(dot, { opacity: 1, duration: 0.2, ease: 'none' })
    .to(proxy, {
        dist: total, duration, ease: 'power1.inOut',
        onUpdate: () => {
            const TAIL = 18;
            const pos = posAtDist(pts, lens, proxy.dist);
            const tail = posAtDist(pts, lens, Math.max(0, proxy.dist - TAIL));
            (dot as unknown as SVGLineElement).setAttribute('x1', String(tail.x));
            (dot as unknown as SVGLineElement).setAttribute('y1', String(tail.y));
            (dot as unknown as SVGLineElement).setAttribute('x2', String(pos.x));
            (dot as unknown as SVGLineElement).setAttribute('y2', String(pos.y));
        }
    })
    .to(dot, { opacity: 0, duration: 0.2, ease: 'none' }, '-=0.2');
}

const traceData = Array.from(traces).map(trace => ({
    pts: parsePoints(trace),
    lens: segmentLengths(parsePoints(trace)),
    dot: createDot(),
    duration: 0
}));

traceData.forEach(td => { td.duration = 1.5 + (totalLength(td.lens) / 800) * 2.5; });

function startAll() {
    if (running) return;
    running = true;
    traceData.forEach((td, i) => {
        const id = setTimeout(() => animateDot(td.dot, td.pts, td.lens, totalLength(td.lens), td.duration), (i * 0.8 + Math.random() * 1.5) * 1000);
        timeouts.push(id);
    });
}

function stopAll() {
    running = false;
    timeouts.forEach(id => clearTimeout(id));
    timeouts = [];
    gsap.killTweensOf(traceData.map(td => td.dot));
    traceData.forEach(td => gsap.set(td.dot, { opacity: 0 }));
}

const section = document.getElementById('works')!;
new IntersectionObserver((entries) => {
    entries.forEach(entry => entry.isIntersecting ? startAll() : stopAll());
}, { threshold: 0.1 }).observe(section);
</script>

<style>
    .works {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: var(--space-24) var(--space-8);
        width: 100%;
        position: relative;
        overflow: hidden;
    }

    .works-inner {
        position: relative;
        z-index: 1;
        width: 100%;
    }

    .works-heading {
        font-size: var(--text-hero);
        font-family: var(--font-display);
        color: var(--text);
        line-height: 1;
        margin-bottom: var(--space-12);
    }

    .keycap-grid {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
    }

    .keycap-row {
        display: flex;
        gap: var(--space-3);
    }

    .keycap-row-stagger {
        margin-left: 20px;
    }

    .keycap {
        position: relative;
        display: block;
        text-decoration: none;
        cursor: pointer;
        flex-shrink: 0;
    }

    .keycap-2u { width: clamp(200px, 28vw, 320px); }
    .keycap-1u { width: clamp(160px, 20vw, 240px); }

    .keycap-top {
        background: var(--surface);
        border: 1.5px solid rgba(14, 165, 201, 0.3);
        border-radius: 10px 10px 8px 8px;
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        position: relative;
        z-index: 1;
        box-shadow:
            inset 0 1px 0 rgba(14, 165, 201, 0.08),
            inset 0 -1px 0 rgba(0, 0, 0, 0.4),
            0 0 12px rgba(14, 165, 201, 0.05),
            0 2px 0 rgba(0, 0, 0, 0.6);
        transition: border-color 180ms ease, box-shadow 180ms ease;
    }

    .keycap:hover .keycap-top {
        border-color: rgba(14, 165, 201, 0.7);
        box-shadow:
            inset 0 1px 0 rgba(14, 165, 201, 0.12),
            inset 0 -1px 0 rgba(0, 0, 0, 0.4),
            0 0 20px rgba(14, 165, 201, 0.15),
            0 2px 0 rgba(0, 0, 0, 0.6);
    }

    .keycap-side {
        height: 8px;
        background: rgba(6, 8, 12, 0.95);
        border: 1.5px solid rgba(14, 165, 201, 0.2);
        border-top: none;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
    }

    .keycap-legend {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .keycap-name {
        font-family: var(--font-display);
        font-size: var(--text-lg);
        color: var(--text);
        font-weight: 600;
    }

    .keycap-arrow {
        color: var(--trace);
        opacity: 0.4;
        transition: opacity 150ms ease, transform 150ms ease;
    }

    .keycap:hover .keycap-arrow {
        opacity: 1;
        transform: translate(2px, -2px);
    }

    .keycap-desc {
        font-size: var(--text-xs);
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 28ch;
    }

    .keycap-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        margin-top: var(--space-1);
    }

    .tag {
        font-size: 10px;
        background: rgba(14, 165, 201, 0.1);
        color: var(--trace);
        border: 1px solid rgba(14, 165, 201, 0.2);
        padding: 2px var(--space-2);
        border-radius: 999px;
        letter-spacing: 0.03em;
    }

    .more-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-sm);
        color: var(--text-muted);
        text-decoration: none;
        margin-top: var(--space-2);
        margin-bottom: var(--space-16);
        transition: color 180ms ease;
    }

    .more-link:hover { color: var(--trace); }

    .hackatime {
        border-top: 1px solid rgba(14, 165, 201, 0.15);
        padding-top: var(--space-12);
    }

    .hackatime-heading {
        font-size: var(--text-2xl);
        font-family: var(--font-display);
        color: var(--text);
        margin-bottom: var(--space-8);
        font-weight: 400;
    }

    .hackatime-badge img {
        max-width: 100%;
        height: auto;
    }

    .traces {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .trace {
        fill: none;
        stroke: #0ea5c9;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.7;
        filter: drop-shadow(0 0 3px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.5));
    }

    .pad {
        fill: #0ea5c9;
        opacity: 0.9;
        filter: drop-shadow(0 0 4px #0ea5c9) drop-shadow(0 0 10px rgba(14,165,201,0.5));
    }

    @media (max-width: 768px) {
        .keycap-row { flex-direction: column; }
        .keycap-row-stagger { margin-left: 0; }
        .keycap-2u, .keycap-1u { width: 100%; }
    }
</style>