---
---
<nav class="navbar">
    <div class="nav-inner">
        <ul class="nav-links">
            <li><a href="#home" class="nav-link active">Home</a></li>
            <li><a href="#about" class="nav-link">About</a></li>
            <li><a href="#works" class="nav-link">Works</a></li>
        </ul>
        <div class="nav-indicator"></div>
    </div>
</nav>

<script>
    const links = document.querySelectorAll('.nav-link') as NodeListOf<HTMLAnchorElement>;
    const indicator = document.querySelector('.nav-indicator') as HTMLElement;
    const sections = ['home', 'about', 'works'];

    function moveIndicator(link: HTMLAnchorElement) {
        const linkRect = link.getBoundingClientRect();
        const navRect = indicator.closest('.nav-inner')!.getBoundingClientRect();
        const centerX = linkRect.left - navRect.left + linkRect.width / 2;
        indicator.style.left = `${centerX}px`;
    }

    function setActive(id: string) {
        links.forEach(l => l.classList.remove('active'));
        const activeLink = document.querySelector(`.nav-link[href="#${id}"]`) as HTMLAnchorElement;
        if (!activeLink) return;
        activeLink.classList.add('active');
        moveIndicator(activeLink);
    }

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) setActive(entry.target.id);
        });
    }, { threshold: 0.4 });

    sections.forEach(id => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
    });

    window.addEventListener('load', () => {
        const active = document.querySelector('.nav-link.active') as HTMLAnchorElement;
        if (active) moveIndicator(active);
    });

    links.forEach(link => {
        link.addEventListener('click', () => {
            const id = link.getAttribute('href')!.replace('#', '');
            setActive(id);
        });
    });
</script>

<style>
    .navbar {
        position: fixed;
        top: 15px;
        left: 15%;
        transform: translateX(-50%);
        z-index: 100;
    }

    .nav-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-8);
        padding-bottom: var(--space-4);
        border: 1px solid rgba(14, 165, 201, 0.25);
        border-radius: 999px;
        background: rgba(8, 10, 15, 0.4);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .nav-links {
        display: flex;
        list-style: none;
        gap: var(--space-8);
        margin: 0;
        padding: 0;
    }

    .nav-links a {
        font-size: var(--text-sm);
        color: var(--text-muted);
        transition: color 180ms ease;
        letter-spacing: 0.02rem;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--trace);
    }

    .nav-indicator {
        position: absolute;
        bottom: var(--space-2);    /* sits near the bottom of the pill */
        left: 0;                   /* JS sets this */
        transform: translateX(-50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--trace);
        box-shadow: 0 0 6px var(--trace), 0 0 12px rgba(14, 165, 201, 0.5);
        transition: left 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
</style>